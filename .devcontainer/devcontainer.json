// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "Debian",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:bullseye",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers/features/node:1": {}
	},

	"onCreateCommand": "/bin/bash -c \"$(curl -fsSL https://php.new/install/linux/8.4)\" && sudo apt-get update && sudo apt-get install mariadb-client -y",
	"postStartCommand": "docker compose up -d && echo In the achievement-system folder, run composer install, npm install, npm run build, php artisan key:generate and php artisan config:cache, php artisan migrate and php artisan db:seed after you create the container for the first time",
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"bmewburn.vscode-intelephense-client",
				"laravel.vscode-laravel",
				"onecentlin.laravel-blade"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
